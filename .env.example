# Copy to .env for local development. On Railway set these as service variables
# instead — .env is gitignored and never ships in the image.

# --- Keycloak -----------------------------------------------------------------
# Must be the SAME issuer the backend validates tokens against, otherwise the
# backend rejects every token this gateway relays.
KEYCLOAK_ISSUER_URI=http://localhost:9090/realms/ai-career
KEYCLOAK_BFF_CLIENT_ID=ai-career-bff
# Keycloak -> Clients -> ai-career-bff -> Credentials -> Client secret
KEYCLOAK_BFF_CLIENT_SECRET=

# --- Upstreams ----------------------------------------------------------------
# BACKEND_URI
#   Local:   http://localhost:8080
#   Railway: http://<backend-service>.railway.internal:8080  (private network)
#
# FRONTEND_URI
#   Local:   http://localhost:3000
#   Vercel:  https://<project>.vercel.app   — no trailing slash, https required
#
# ADMIN_FRONTEND_URI
#   The admin console, served under /admin. It runs on its own port so both
#   frontends can be up at once; it must keep `basePath: "/admin"` in its
#   next.config.ts or its asset requests miss this route and hit the main app.
#   Local:   http://localhost:3001
#   Vercel:  https://<admin-project>.vercel.app   — no trailing slash
BACKEND_URI=http://localhost:8080
FRONTEND_URI=http://localhost:3000
ADMIN_FRONTEND_URI=http://localhost:3001

# --- Server -------------------------------------------------------------------
# Railway injects PORT itself; leave it unset there.
PORT=8090
# true on Railway (HTTPS). Must stay false on plain-HTTP localhost, or the
# browser silently drops the session cookie and login appears to do nothing.
SESSION_COOKIE_SECURE=false

# Accepted ID token signing algorithms. Defaults to RS256,RS384,RS512 — the same
# set the backend accepts — so the gateway works against a realm whichever of
# them it signs with. Local Keycloak signs RS512; production signs RS256.
# Only set this to narrow the list.
# APP_OIDC_IDTOKENSIGNATUREALGORITHMS=RS256,RS384,RS512
